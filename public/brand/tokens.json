{
  "$description": "Opuntia Den design tokens. Mirrors tokens.css.",
  "color": {
    "crema":   { "value": "#EEECE6", "role": "fondo principal" },
    "papel":   { "value": "#F6F5F1", "role": "superficies claras" },
    "tinta":   { "value": "#1C2320", "role": "texto y líneas" },
    "noche":   { "value": "#161B19", "role": "fondos oscuros" },
    "tuna":    { "value": "#247465", "role": "acento puntual (estrellas, tunas, kickers)" },
    "gris":    { "value": "#5B5F5A", "role": "texto secundario" },
    "linea":   { "value": "#D6D2C8", "role": "divisores y bordes" },
    "arenaTexto": { "value": "#B4B6B0", "role": "texto secundario sobre noche" },
    "puntoOscuro": { "value": "#6B6158", "role": "anillo de puntos sobre noche" },
    "kraft":   { "value": "#C4A47C", "role": "empaque impreso" },
    "olivo":   { "value": "#247465", "role": "banda verde de la web" },
    "cremas": {
      "papel": "#F6F5F1", "hueso": "#F2F1EC", "base": "#EEECE6", "lino": "#E4E1D9", "arena": "#D7D3C9"
    }
  },
  "font": {
    "display": "Playfair Display, Iowan Old Style, Georgia, serif",
    "body": "Inter, system-ui, -apple-system, Segoe UI, sans-serif",
    "weights": { "display": [400, 500, "400 italic"], "body": [400, 500, 600] }
  },
  "fontSize": { "xs": "11px", "sm": "13px", "base": "16px", "lg": "20px", "xl": "28px", "2xl": "40px", "3xl": "56px", "hero": "clamp(56px, 12vw, 144px)" },
  "letterSpacing": { "label": "0.22em", "hero": "0.02em" },
  "radius": { "sm": "4px", "md": "10px", "pill": "999px" },
  "shadow": { "flat": "3px 3px 0 rgba(51,36,20,0.10)" }
}
